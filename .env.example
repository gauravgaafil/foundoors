# WordPress WPGraphQL endpoint
WORDPRESS_API_URL=https://your-site.com/graphql

# WordPress image hostname (for next/image remote patterns)
WORDPRESS_IMAGE_HOSTNAME=your-site.com

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://foundoors.com

# Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# On-demand revalidation secret
REVALIDATE_SECRET=your-secret-token-here

# Site metadata
NEXT_PUBLIC_SITE_NAME=Foundoors
NEXT_PUBLIC_SITE_DESCRIPTION=AI-first news and authority publication platform
