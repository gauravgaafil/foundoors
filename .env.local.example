# WordPress / WPGraphQL
WORDPRESS_API_URL=https://your-wordpress-site.com/graphql
WORDPRESS_IMAGE_HOSTNAME=your-wordpress-site.com

# WordPress Auth (for draft previews — use Application Password)
WORDPRESS_AUTH_REFRESH_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://foundoors.com
NEXT_PUBLIC_SITE_NAME=Foundoors

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Search Console Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# On-demand ISR revalidation secret (use a strong random string)
REVALIDATE_SECRET=your-strong-random-secret-here

# n8n webhook secret (optional)
N8N_WEBHOOK_SECRET=
